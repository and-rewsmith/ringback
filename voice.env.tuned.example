# Tuned config for the ringback-voice MCP: the settings Andrew runs with, on top of the
# stock defaults in voice.env.example. To use it:
#   cp voice.env.tuned.example voice.env      (voice.env is gitignored; never commit it)
#   then fill in the 3 SIP vars below with YOUR OWN account.
#
# Needs this branch (agent-andsmi/local-voice-fixes): it adds VOICE_MAX_TURN_SEC and
# expands $HOME in the whisper model paths. Upstream main ignores the former and would
# need full paths for the latter.
#
# Keep comments on their own lines (works on any branch).

# ===== REQUIRED — your SIP account =====
# Free account: https://subscribe.linphone.org  (or "Create account" in the Linphone app).
export VOICE_SIP_ID="sip:YOURUSER@sip.linphone.org"
export VOICE_SIP_USER="YOURUSER"
export VOICE_SIP_PASS="YOUR_SIP_PASSWORD"

# ===== Tuned (differs from the stock defaults) =====
# Speech-to-text: large-v3-turbo is much more accurate than the default small.en / base.en.
# setup only downloads base.en and small.en, so fetch this one first (~1.6 GB):
#   curl -L -o ~/.whisper-models/ggml-large-v3-turbo.bin \
#     https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-large-v3-turbo.bin
export WHISPER_MODEL="$HOME/.whisper-models/ggml-large-v3-turbo.bin"
export WHISPER_SERVER_MODEL="$HOME/.whisper-models/ggml-large-v3-turbo.bin"
# Loudness above which you count as still talking. Default 600 was too high for a phone line
# (quiet speech got cut off); raise it again if background noise keeps turns from ending.
export VOICE_LISTEN_END_RMS="350"
# Pause needed before your turn ends. Default 1.5 s; 2.0 s leaves room to think mid-sentence.
export VOICE_END_SILENCE="2.0"
# Longest a single turn may run. Default 15 s cut off long explanations; 600 s = 10 min.
export VOICE_MAX_TURN_SEC="600"
